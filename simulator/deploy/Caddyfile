# Демо на домене с TLS (Let's Encrypt автоматически): DOMAIN=demo.example.ru.
# Без домена DOMAIN=:80 - просто http.
{$DOMAIN::80} {
	encode gzip
	# rosbridge слушает путь "/": префикс /ros снимается; WebSocket проксируется сам
	handle_path /ros* {
		reverse_proxy tram-live:9090
	}
	handle {
		root * /srv
		file_server
	}
}
