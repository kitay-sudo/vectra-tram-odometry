# Настройки docker compose. Скопируйте в .env и поправьте:  cp .env.example .env
# Все переменные необязательны: без .env берутся значения по умолчанию из
# docker-compose.yml (указаны здесь же).

# ---- данные и прогон для демо (сервис player)
# Папка с прогонами data/<bag_id>/{metadata.yaml,*.db3}. Путь относительный от
# корня репозитория или абсолютный (Windows: E:/MY-PROJECT/TrackVector/data).
DATA_DIR=./data
# Какой прогон проигрывать (по умолчанию отложенный 30618_e9a34502, 20 мин).
BAG=30618_e9a34502
# 1 — проигрывать по кругу (демо-сервер); 0 — один раз.
PLAY_LOOP=0
# Скорость проигрывания и пауза перед стартом, с.
PLAY_RATE=1.0
PLAY_DELAY=2
# Сколько подписчиков входов ждать перед проигрыванием (нода + проба).
WAIT_SUBSCRIBERS=2

# ---- ROS 2
# Домен DDS. Сеть compose изолирована, конфликт с другими машинами исключён;
# при запуске на общем сервере рядом с чужим ROS 2 задайте свой номер (0..101).
ROS_DOMAIN_ID=42

# ---- проба (tools/ros_probe.py)
# Выйти после стольких секунд тишины и напечатать итог; 0 — работать до останова.
PROBE_IDLE=20
# Промежуточная сводка раз в столько секунд (0 — только в конце).
PROBE_REPORT_EVERY=30

# ---- порты демо на ноутбуке
# Интерфейс, на котором открыты порты: 127.0.0.1 — только этот компьютер,
# 0.0.0.0 — вся сеть (нужно, если страница открыта с другого устройства).
WEB_BIND=127.0.0.1
WEB_PORT=8080
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=9090
# 1 — rosbridge без ограничений (отладка). По умолчанию 0: мост только для
# чтения (подписка на /result/*, /tram/*, /vehicle/*, /sensing/gnss/master/*;
# публикация и параметры закрыты) — обязательно для публичного домена.
ROSBRIDGE_OPEN=0

# ---- публичный демо-сервер (docker compose --profile server up -d)
# Домен сервера: страница https://PUBLIC_HOST/, мост wss://PUBLIC_HOST/ros
PUBLIC_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Каталог с PEM-сертификатом и ключом (монтируется в /etc/nginx/certs).
# Нет файлов — прокси работает только по HTTP.
TLS_DIR=./docker/proxy/certs
TLS_CERT=/etc/nginx/certs/fullchain.pem
TLS_KEY=/etc/nginx/certs/privkey.pem

# ---- тесты: FAST=1 пропускает 4 самых долгих теста имитатора (маркер slow),
# NO_TIMING=1 (по умолчанию) — без проверок времени шага по стенным часам (маркер
# timing: под нагрузкой CPU «мигают»); запустить их: docker compose run --rm test -m timing
FAST=0
NO_TIMING=1

# ---- образ: тег собранного образа (docker compose build)
VECTRA_IMAGE=vectra/tram:compose
