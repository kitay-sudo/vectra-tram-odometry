# Общие location для :80 и :443 (подключается include, сам в http{} не входит).
root /usr/share/nginx/html;
# sendfile off: на bind-mount Docker Desktop (Windows/macOS) sendfile отдаёт 0 байт
sendfile off;
index index.html;

location / {
    try_files $uri $uri/ =404;
}

# rosbridge слушает websocket на пути "/": префикс /ros снимается.
location = /ros {
    proxy_pass http://bridge:9090/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
location /ros/ {
    proxy_pass http://bridge:9090/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
}
